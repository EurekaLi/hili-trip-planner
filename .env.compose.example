# Compose infrastructure
# Absolute or relative path to a separate checkout containing hili_agents/.
HILI_AGENTS_SOURCE=../hili-agents
POSTGRES_DB=trip_planner
POSTGRES_USER=trip_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=8000
WEB_PORT=8080
CELERY_CONCURRENCY=2

# Required external providers
AMAP_API_KEY=replace-with-amap-web-service-key
DASHSCOPE_API_KEY=replace-with-dashscope-key
DASHSCOPE_MODEL_ID=qwen3.6-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Browser-visible AMap configuration, compiled into the frontend image
VITE_AMAP_WEB_JS_KEY=replace-with-amap-js-key
VITE_AMAP_SECURITY_JS_CODE=replace-with-amap-security-code
VITE_AMAP_SERVICE_HOST=

# Public origin and cookie policy
PUBLIC_ORIGIN=http://localhost:8080
AUTH_COOKIE_SECURE=false
PRIVACY_CONTACT_EMAIL=privacy@example.com

# Optional providers and observability
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Keep empty for the bundled local Prometheus profile. Production collectors should
# configure a bearer token in both the API and their protected scrape target.
METRICS_BEARER_TOKEN=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional bot protection
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost

# Cost guardrails
LLM_INPUT_COST_PER_MILLION_TOKENS_CNY=0
LLM_OUTPUT_COST_PER_MILLION_TOKENS_CNY=0
GENERATION_COST_BUDGET_CNY=2.0
